---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { identite, bio, expertises, produits, experiences, formations, stack, cvPdf, reseaux } from "../data/profil";

const teinte: Record<string, { bg: string; text: string; border: string; grad: string }> = {
  accent:  { bg: "bg-accent/15",      text: "text-accent-soft",  border: "hover:border-accent/40",      grad: "from-accent/10" },
  mint:    { bg: "bg-mint/15",        text: "text-mint",         border: "hover:border-mint/40",        grad: "from-mint/10" },
  fuchsia: { bg: "bg-fuchsia-400/15", text: "text-fuchsia-300",  border: "hover:border-fuchsia-400/40", grad: "from-fuchsia-500/10" },
  amber:   { bg: "bg-amber-400/15",   text: "text-amber-300",    border: "hover:border-amber-400/40",   grad: "from-amber-500/10" },
  rose:    { bg: "bg-rose-400/15",    text: "text-rose-300",     border: "hover:border-rose-400/40",    grad: "from-rose-500/10" },
};
---
<Base>
  <!-- ===== Accroche ===== -->
  <section class="relative overflow-hidden pt-36 pb-24 md:pt-44 md:pb-32">
    <div class="grid-bg pointer-events-none absolute inset-0"></div>
    <div class="animate-glow pointer-events-none absolute -top-40 left-1/2 h-[480px] w-[780px] rounded-full bg-accent/20 blur-[120px]"></div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-6 md:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="animate-in mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium" style="--d:0">
          <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint opacity-60"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-mint"></span></span>
          {identite.badge}
        </p>
        <h1 class="animate-in text-4xl font-extrabold leading-tight tracking-tight text-white md:text-6xl" style="--d:1">
          Je mets l'IA <span class="text-shine bg-gradient-to-r from-accent-soft via-mint to-accent-soft bg-clip-text text-transparent">en production</span>, pas en démo.
        </h1>
        <p class="animate-in mt-6 max-w-xl text-lg leading-relaxed text-slate-400" style="--d:2">{identite.intro}</p>
        <div class="animate-in mt-10 flex flex-wrap gap-4" style="--d:3">
          <a href={identite.rendezVous} target="_blank" rel="noopener"
             class="group inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 font-semibold text-white shadow-lg shadow-accent/25 transition hover:bg-accent/90 hover:shadow-accent/40">
            Discutons de votre projet
            <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
          </a>
          <a href="#produits" class="inline-flex items-center rounded-lg border border-white/15 px-6 py-3 font-semibold text-white transition hover:bg-white/5">Voir mes produits</a>
        </div>
        <div class="animate-in mt-10" style="--d:4"><SocialLinks /></div>
      </div>

      <div class="animate-in relative mx-auto w-full max-w-sm" style="--d:2">
        <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-accent/30 to-mint/20 blur-2xl"></div>
        <div class="group relative overflow-hidden rounded-3xl border border-white/10 bg-slate-900">
          <img src={identite.photo} alt={`Portrait de ${identite.nom}`} class="aspect-[4/5] w-full object-cover grayscale transition duration-700 ease-out group-hover:scale-[1.03] group-hover:grayscale-0 group-active:grayscale-0"
               onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
          <div class="hidden aspect-[4/5] w-full place-items-center bg-gradient-to-br from-slate-800 to-slate-900"><img src="/logo-mark.png" alt="" class="w-1/3 opacity-30" /></div>
        </div>
        <div class="animate-float absolute -bottom-8 -left-8 hidden w-64 rounded-xl border border-white/10 bg-ink/90 p-4 font-mono text-xs shadow-2xl backdrop-blur md:block">
          <div class="mb-2 flex gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span><span class="h-2.5 w-2.5 rounded-full bg-yellow-400/70"></span><span class="h-2.5 w-2.5 rounded-full bg-green-400/70"></span>
          </div>
          <p><span class="text-accent-soft">agent</span>.<span class="text-mint">run</span>(<span class="text-amber-300">"refactor"</span>)</p>
          <p class="text-slate-500">→ 12 fichiers analysés</p>
          <p class="caret text-slate-500">→ PR ouverte, tests ✓</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== À propos ===== -->
  <section id="a-propos" class="border-t border-white/5 py-24">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 md:grid-cols-[1fr_1.6fr]">
      <div class="reveal">
        <p class="font-mono text-sm text-accent-soft">01 — À propos</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">Qui je suis</h2>
      </div>
      <div class="reveal space-y-5 text-lg leading-relaxed text-slate-400" style="--d:1">
        {bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ===== Expertise ===== -->
  <section id="expertise" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <p class="reveal font-mono text-sm text-accent-soft">02 — Expertise</p>
      <h2 class="reveal mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">Ce que j'apporte à une équipe</h2>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {expertises.map((e, i) => (
          <article class={`reveal rounded-2xl border border-white/10 bg-white/[.02] p-6 transition duration-300 hover:-translate-y-1 hover:bg-white/[.04] ${teinte[e.couleur].border}`} style={`--d:${i}`}>
            <div class={`mb-5 grid h-11 w-11 place-items-center rounded-xl ${teinte[e.couleur].bg} ${teinte[e.couleur].text}`}><Icon name={e.icone} /></div>
            <h3 class="font-semibold text-white">{e.titre}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{e.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Produits ===== -->
  <section id="produits" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="font-mono text-sm text-accent-soft">03 — Produits</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">Ce que je construis à côté</h2>
          <p class="mt-3 max-w-xl text-slate-400">Des produits SaaS conçus, développés et mis en ligne de bout en bout.</p>
        </div>
        <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-slate-400">Produits en ligne · code privé</span>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {produits.map((p, i) => (
          <a href={p.url} target="_blank" rel="noopener" style={`--d:${i % 2}`}
             class={`reveal group relative overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br ${teinte[p.couleur].grad} to-transparent p-8 transition duration-300 hover:-translate-y-1 ${teinte[p.couleur].border}`}>
            <div class="flex items-start justify-between">
              <span class={`rounded-md px-2 py-1 text-xs font-medium ${teinte[p.couleur].bg} ${teinte[p.couleur].text}`}>{p.tag}</span>
              <span class="text-slate-500 transition group-hover:-translate-y-0.5 group-hover:translate-x-1 group-hover:text-white">↗</span>
            </div>
            <h3 class="mt-6 text-2xl font-bold text-white">{p.nom}</h3>
            <p class="mt-2 text-slate-400">{p.description}</p>
            <p class="mt-6 font-mono text-xs text-slate-500">{p.url.replace("https://", "")}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Parcours + Stack ===== -->
  <section id="parcours" class="border-t border-white/5 py-24">
    <div class="mx-auto grid max-w-6xl gap-16 px-6 md:grid-cols-2">
      <div>
        <p class="reveal font-mono text-sm text-accent-soft">04 — Parcours</p>
        <h2 class="reveal mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">Expérience</h2>
        <div class="mt-10 border-l border-white/10 pl-6">
          {experiences.map((x, i) => (
            <div class={`reveal relative ${i > 0 ? "mt-10" : ""}`} style={`--d:${i}`}>
              <span class={`absolute -left-[31px] top-1.5 h-3 w-3 rounded-full ring-4 ${i === 0 ? "bg-accent ring-accent/20" : "bg-mint ring-mint/20"}`}></span>
              <p class="text-sm text-slate-500">{x.periode}</p>
              <h3 class="mt-1 text-lg font-semibold text-white">{x.poste}</h3>
              <p class="mt-2 text-slate-400">{x.description}</p>
            </div>
          ))}
        </div>
        {formations.length > 0 && (
          <div class="reveal mt-12">
            <h3 class="text-xl font-bold text-white">Formation</h3>
            <ul class="mt-4 space-y-3">
              {formations.map((f) => (
                <li><span class="text-sm text-slate-500">{f.periode}</span><p class="font-medium text-white">{f.diplome}</p><p class="text-sm text-slate-400">{f.ecole}</p></li>
              ))}
            </ul>
          </div>
        )}
        <div class="reveal mt-10 flex flex-wrap gap-3">
          <a href={reseaux.linkedin.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-semibold text-accent-soft transition hover:text-white">
            <Icon name="linkedin" class="h-4 w-4" /> Parcours complet sur LinkedIn →
          </a>
          {cvPdf && <a href={cvPdf} target="_blank" class="text-sm font-semibold text-accent-soft transition hover:text-white">Télécharger mon CV (PDF) →</a>}
        </div>
      </div>
      <div>
        <p class="reveal font-mono text-sm text-accent-soft">05 — Stack</p>
        <h2 class="reveal mt-3 text-3xl font-bold tracking-tight text-white md:text-4xl">Mes outils</h2>
        <div class="mt-10 flex flex-wrap gap-3">
          {stack.map((s, i) => (
            <span class="reveal rounded-lg border border-white/10 bg-white/[.03] px-4 py-2 font-mono text-sm text-slate-200 transition hover:border-accent/40 hover:text-white" style={`--d:${i}`}>{s}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Contact ===== -->
  <section id="contact" class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-4xl px-6">
      <div class="reveal relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-accent/20 via-ink to-mint/10 p-10 text-center md:p-16">
        <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">Un projet IA à mettre en production ?</h2>
        <p class="mx-auto mt-4 max-w-xl text-slate-300">Recrutement, conseil ou collaboration : parlons-en 30 minutes.</p>
        <div class="mt-10 flex justify-center">
          <a href={identite.rendezVous} target="_blank" rel="noopener" class="rounded-lg bg-white px-6 py-3 font-semibold text-ink transition hover:bg-slate-200">Prendre rendez-vous</a>
        </div>
        <div class="mt-8 flex justify-center"><SocialLinks /></div>
      </div>
    </div>
  </section>
</Base>
