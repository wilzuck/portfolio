---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const articles = await getCollection("blog", ({ data }) => !data.brouillon);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
---
<Base title={`${article.data.titre} · Wilfried ETEKA`} description={article.data.description}>
  <article class="mx-auto max-w-3xl px-6 pt-36 pb-24">
    <a href="/blog" class="text-sm text-accent-soft hover:text-white">← Tous les articles</a>
    <p class="mt-8 text-sm text-slate-500">{article.data.date.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-white">{article.data.titre}</h1>
    <div class="article mt-10 space-y-5 text-lg leading-relaxed text-slate-300 [&_a]:text-accent-soft [&_a]:underline [&_code]:rounded [&_code]:bg-white/10 [&_code]:px-1.5 [&_h2]:mt-12 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-white [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-white [&_li]:ml-6 [&_ol]:list-decimal [&_strong]:text-white [&_ul]:list-disc">
      <Content />
    </div>
  </article>
</Base>
